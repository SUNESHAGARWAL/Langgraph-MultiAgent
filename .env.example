# ============================================================================
# Multi-Agent Orchestrator Configuration - V5.0 Simplified
# ============================================================================

# ----------------------------------------------------------------------------
# Azure OpenAI Configuration
# ----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Model Deployments
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Model Configuration
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ----------------------------------------------------------------------------
# Databricks Configuration
# ----------------------------------------------------------------------------
DATABRICKS_HOST=https://your-workspace.databricks.com
DATABRICKS_TOKEN=your-databricks-token-here
DATABRICKS_WORKSPACE_ID=your-workspace-id

# SQL Warehouse Configuration (Optional for Genie-only mode)
DATABRICKS_SQL_WAREHOUSE_ID=your-sql-warehouse-id

# Genie Configuration
# Find in Databricks: Genie → Your Space → Settings → Copy Space ID
GENIE_SPACE_ID=your-genie-space-id
GENIE_TIMEOUT=30

# Unity Catalog Configuration
# IMPORTANT: For comma-separated lists, do NOT use quotes around individual items!
# CORRECT:   UNITY_CATALOG_TABLES=table1,table2,table3
# WRONG:     UNITY_CATALOG_TABLES='table1','table2','table3'
UNITY_CATALOG_NAME=main
UNITY_CATALOG_SCHEMA=default
UNITY_CATALOG_TABLES=sales_data,customer_data,product_data

# ----------------------------------------------------------------------------
# MLflow Configuration
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/your-email@company.com/multi-agent-orchestrator

# ----------------------------------------------------------------------------
# RAG Configuration (Document-based Q&A + Context Enrichment)
# ----------------------------------------------------------------------------
RAG_ENABLED=false
RAG_DOCUMENTS_PATH=./data/documents
RAG_VECTOR_STORE_PATH=./data/vector_stores/rag_index

# Chunking Settings
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Search Settings
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.7

# Standalone Q&A Mode (answer directly from documents)
RAG_ENABLE_STANDALONE_QA=true
RAG_STANDALONE_THRESHOLD=0.85

# ----------------------------------------------------------------------------
# Smart SQL Cache Configuration
# ----------------------------------------------------------------------------
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_MAX_ENTRIES=1000

# ----------------------------------------------------------------------------
# Agent Configuration
# ----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=10
AGENT_MAX_CONCURRENT_QUERIES=3
AGENT_ENABLE_HUMAN_FEEDBACK=true

# Orchestrator Configuration
ORCHESTRATOR_MAX_PLANNING_STEPS=5
ORCHESTRATOR_ENABLE_REFLECTION=true
ORCHESTRATOR_CONFIDENCE_THRESHOLD=0.7

# Timeouts
AGENT_TIMEOUT=300
QUERY_TIMEOUT=120

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=detailed
LOG_FILE=logs/agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
APP_NAME=multi-agent-orchestrator
APP_VERSION=5.0.0
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_SESSION_STORAGE_PATH=./data/sessions

# Performance
ASYNC_WORKERS=4
BATCH_SIZE=10
REQUEST_TIMEOUT=120
