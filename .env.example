# ============================================================================
# Multi-Agent Orchestrator Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Azure OpenAI Configuration
# ----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Model Deployments
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Model Configuration
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
EMBEDDING_CHUNK_SIZE=1000
EMBEDDING_CHUNK_OVERLAP=200

# ----------------------------------------------------------------------------
# Databricks Configuration
# ----------------------------------------------------------------------------
DATABRICKS_HOST=https://your-workspace.databricks.com
DATABRICKS_TOKEN=your-databricks-token-here
DATABRICKS_WORKSPACE_ID=your-workspace-id

# Genie Configuration
GENIE_SPACE_ID=your-genie-space-id
GENIE_TIMEOUT=30

# Unity Catalog Configuration
# IMPORTANT: For comma-separated lists, do NOT use quotes around individual items!
# CORRECT:   UNITY_CATALOG_TABLES=table1,table2,table3
# WRONG:     UNITY_CATALOG_TABLES='table1','table2','table3'  ← Will include quotes in value!
UNITY_CATALOG_NAME=main
UNITY_CATALOG_SCHEMA=default
UNITY_CATALOG_TABLES=sales_data,customer_data,product_data

# ----------------------------------------------------------------------------
# Azure Blob Storage Configuration
# IMPORTANT: Vector stores and all persistent data are stored in Azure Blob
# Storage for production scalability (not on local disk).
# ----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_CACHE=agent-cache
AZURE_STORAGE_CONTAINER_RAG=agent-rag-docs
AZURE_STORAGE_CONTAINER_EDA=agent-eda-results

# NOTE: Vector stores are automatically persisted to a "vector-stores" container
# in the above storage account. No additional configuration needed.

# ----------------------------------------------------------------------------
# RAG File Monitoring
# IMPORTANT: RAG monitors Azure Blob Storage container (not local filesystem).
# Upload files to the RAG container and they'll be automatically processed.
# ----------------------------------------------------------------------------
# RAG_WATCH_PATH is not used (deprecated - was for local filesystem monitoring)
# Files are monitored in the AZURE_STORAGE_CONTAINER_RAG container above
RAG_AUTO_PROCESS=true
RAG_SUPPORTED_EXTENSIONS=.pdf,.txt,.csv,.docx,.pptx,.xlsx
RAG_POLL_INTERVAL=10  # How often to check for new blobs (seconds)

# ----------------------------------------------------------------------------
# Redis Configuration (Optional - fallback to file-based caching if not set)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_MAX_ENTRIES=10000

# ----------------------------------------------------------------------------
# Vector Store Configuration
# IMPORTANT: Vector stores persist to Azure Blob Storage, not local disk.
# VECTOR_STORE_PATH is only used for temporary operations (FAISS needs local files).
# ----------------------------------------------------------------------------
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_stores  # Temp directory only - data persists to Azure Blob
VECTOR_DIMENSION=1536
SIMILARITY_TOP_K=5

# ----------------------------------------------------------------------------
# MLflow Configuration
# IMPORTANT: MLflow tracking uses Databricks workspace (not local tracking).
# All experiments and runs are stored in Databricks MLflow, accessible from
# the Databricks UI under Machine Learning > Experiments.
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=databricks  # Keep as "databricks" for Databricks workspace tracking
MLFLOW_EXPERIMENT_NAME=/Users/your-email@company.com/multi-agent-orchestrator
MLFLOW_ENABLE_SYSTEM_METRICS=true

# NOTE: When MLFLOW_TRACKING_URI=databricks, the system automatically configures:
#  - Tracking URI: databricks://<your-workspace-host>
#  - Authentication: Uses DATABRICKS_HOST and DATABRICKS_TOKEN from above
#  - All data persists to Databricks workspace, not local filesystem

# ----------------------------------------------------------------------------
# Agent Configuration
# ----------------------------------------------------------------------------
MAX_ITERATIONS=10
MAX_RETRIES=3
ENABLE_HUMAN_IN_LOOP=true
ENABLE_PLANNING=true
ENABLE_FEEDBACK_LOOPS=true

# Orchestrator Settings
ORCHESTRATOR_MAX_PLANNING_STEPS=5
ORCHESTRATOR_CONFIDENCE_THRESHOLD=0.7

# ----------------------------------------------------------------------------
# Logging and Tracing Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TRACING=true
ENABLE_LANGSMITH=false

# LangSmith (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=multi-agent-orchestrator

# OpenTelemetry (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=multi-agent-orchestrator

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
APP_NAME=MultiAgentOrchestrator
APP_VERSION=1.0.0
ENVIRONMENT=development

# Session Configuration
SESSION_STORAGE_PATH=./data/sessions
SESSION_TIMEOUT_MINUTES=30

# Performance Settings
ASYNC_WORKERS=4
BATCH_SIZE=10
REQUEST_TIMEOUT=120
